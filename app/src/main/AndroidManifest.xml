<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Live-уведомление о текущем событии -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Точный будильник к началу и концу события; календарям USE_EXACT_ALARM положен. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Есть ли Google Календарь: тогда напоминания показывает он, а не мы. -->
    <queries>
        <package android:name="com.google.android.calendar" />
    </queries>

    <application
        android:name="com.lpavs.caliinda.app.CaliindaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caliindar"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">
        <activity
            android:name="com.lpavs.caliinda.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Caliindar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Календарь по умолчанию: «открыть календарь» из часов, лаунчера, At a Glance. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_CALENDAR" />
            </intent-filter>
            <!-- «Добавить в календарь» из почты, браузера, билетов. EDIT без id — старый способ того же. -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <!-- Открыть событие: content://com.android.calendar/events/<id> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <!-- Открыть календарь на времени: content://com.android.calendar/time/<ms> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="time/epoch" />
                <data android:scheme="content" />
                <data android:host="com.android.calendar" />
            </intent-filter>
            <!-- .ics: вложения в почте, загрузки. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.CaliindaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/caliinda_widget_info" />
        </receiver>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.date.DateWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_date_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/date_widget_info" />
        </receiver>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.combo.ComboWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_combo_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/combo_widget_info" />
        </receiver>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.countdown.CountdownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_countdown_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <!-- exported: экран выбора события открывает лаунчер при добавлении виджета. -->
        <activity
            android:name="com.lpavs.caliinda.feature.widget.countdown.CountdownConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Caliindar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.stack.StackWidgetProvider"
            android:exported="true"
            android:label="@string/widget_stack_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stack_widget_info" />
        </receiver>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.week.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.add.AddEventWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_add_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/add_widget_info" />
        </receiver>

        <!-- exported: PROVIDER_CHANGED шлёт процесс календаря, а не система. Чужой вызов
             лишь пересчитает уведомление — вреда нет. -->
        <receiver
            android:name="com.lpavs.caliinda.feature.live.LiveEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lpavs.caliinda.action.LIVE_EVENT_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data
                    android:host="com.android.calendar"
                    android:scheme="content" />
            </intent-filter>
        </receiver>

        <!-- exported: EVENT_REMINDER шлёт процесс календаря. Чужой вызов ничего не покажет —
             уведомления берутся из запланированных напоминаний самого календаря. -->
        <receiver
            android:name="com.lpavs.caliinda.feature.reminders.ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data android:scheme="content" />
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>