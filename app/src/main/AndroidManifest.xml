<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Live-уведомление о текущем событии -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Точный будильник к началу и концу события; календарям USE_EXACT_ALARM положен. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <application
        android:name="com.lpavs.caliinda.app.CaliindaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caliindar"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">
        <activity
            android:name="com.lpavs.caliinda.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Caliindar">  <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        </activity>

        <receiver
            android:name="com.lpavs.caliinda.feature.widget.CaliindaWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/caliinda_widget_info" />
        </receiver>

        <!-- exported: PROVIDER_CHANGED шлёт процесс календаря, а не система. Чужой вызов
             лишь пересчитает уведомление — вреда нет. -->
        <receiver
            android:name="com.lpavs.caliinda.feature.live.LiveEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.lpavs.caliinda.action.LIVE_EVENT_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data
                    android:host="com.android.calendar"
                    android:scheme="content" />
            </intent-filter>
        </receiver>
    </application>

</manifest>