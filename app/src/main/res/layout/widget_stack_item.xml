<?xml version="1.0" encoding="utf-8"?>
<!-- Одна карточка стопки: фигура у края, как в ленте, название картинкой и время.
     StackView подменяет параметры корня на wrap_content, поэтому размер задаём внутренней
     карточке из кода (setViewLayoutWidth/Height), иначе карточки разной ширины. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

<FrameLayout
    android:id="@+id/card"
    android:layout_width="250dp"
    android:layout_height="120dp"
    android:background="@drawable/widget_stack_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/card_shape"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/card_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="2dp">

            <ImageView
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true" />

            <ImageView
                android:id="@+id/card_title_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/card_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
</FrameLayout>
